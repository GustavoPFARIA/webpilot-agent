# Model. "auto" uses the first key present: Anthropic, then OpenAI, then Gemini.
# Free option: a Gemini key from https://aistudio.google.com/apikey (no card needed).
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible server (Ollama: http://localhost:11434/v1, Groq, OpenRouter...)
OPENAI_BASE_URL=

# Browser: leave empty for Playwright's Chromium, or use an installed msedge / chrome
BROWSER_CHANNEL=
HEADLESS=true
MAX_STEPS=15

# Security policy (JSON). The agent can only open these hosts and their subdomains.
ALLOWED_DOMAINS=["127.0.0.1","localhost"]
# Credentials used through {{secret:NAME}} placeholders; the model never sees the values.
# The defaults are the demo store's fake account.
SECRETS={"store_username":"demo@acme.test","store_password":"demo-pass-8431"}

# Where the agent's browser reaches this server. Empty = the address you opened in the UI.
PUBLIC_URL=

# API access: {"token":"user"}. Empty = only this machine can call the API.
API_KEYS={}

# Limits and budgets
RUNS_PER_MINUTE=10
MAX_CONCURRENT_RUNS=2
RUN_TIMEOUT_S=600
MAX_TOKENS_PER_RUN=300000
MAX_COST_PER_RUN_USD=1.00
# USD per million tokens. Leave empty for the provider's default (Gemini free tier = 0).
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
PRICE_CACHE_READ_PER_MTOK=

# Model API resilience
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Seconds between model calls (free-tier rate limits). Empty = provider default (Gemini: 6.5)
LLM_MIN_INTERVAL_S=

# Tracing: an OTLP/HTTP collector, or print spans
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_CONSOLE=false
